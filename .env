HTTPBIN_URL=https://httpbin.org
REQRES_URL=https://reqres.in/api
GRAPHQL_URL=https://countries.trevorblades.com/graphql
MCP_DEEPWIKI_URL=https://mcp.deepwiki.com/mcp
BASE_URL=https://httpbin.org
API_TOKEN=widget-demo-token

# Fallback value for Manual Testing/Tool Scenario/Widget Tools.void's `id`
# toolparam (an agent-sourced param) — an MCP client normally supplies this
# at call time; this env var only lets `tool verify`'s proof runs resolve it.
id=widget-7

# Stand-ins for Automated Tests/MCP/Tool Decorated Request.void's agent-sourced toolparams
# (customer_name / customer_email). An MCP client would normally supply these
# at call time via the /tool block's binds mechanism; @voiden/runner@2.2.0 has
# no `tool verify` / `mcp serve` yet to exercise that path (see KNOWN-ISSUES.md),
# so these let the underlying request still run in a plain `voiden-runner run` sweep.
customer_name=Ada Lovelace
customer_email=ada@example.com
