# Stand-ins for mcp/tool-decorated-request.void's agent-sourced toolparams
# (customer_name / customer_email). An MCP client would normally supply these
# at call time via the /tool block's binds mechanism; @voiden/runner@2.2.0 has
# no `tool verify` / `mcp serve` yet to exercise that path (see KNOWN-ISSUES.md),
# so these let the underlying request still run in a plain `voiden-runner run` sweep.
customer_name=Ada Lovelace
customer_email=ada@example.com
