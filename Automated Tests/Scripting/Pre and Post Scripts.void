type: request
attrs:
  uid: "6a63e01b-4c80-42d7-a5d5-f2d26f6b4b7c"
content:
  - type: method
    attrs:
      uid: "09cbbf53-fc01-4d7c-bcf0-a48f6d3a0a77"
      method: GET
      visible: true
    content: GET
  - type: url
    attrs:
      uid: "6eccb98d-f9a5-45e1-8e97-3573e8085d2f"
    content: "{{HTTPBIN_URL}}/headers"
---
```

```void
---
type: pre_script
attrs:
  uid: "42a2e919-b889-4c9e-9b98-dfb930abcf7d"
  language: javascript
  body: |
    voiden.request.headers.push({ key: "X-Script-Lang", value: "javascript" });
    voiden.variables.set("script_lang", "javascript");
---
```

```void
---
type: post_script
attrs:
  uid: "9ab58d1e-2ecd-44c6-aa3b-3b5d8707b59f"
  language: javascript
  body: |
    const body = voiden.response.body;
    voiden.assert(voiden.response.status, "==", 200, "Status 200");
    voiden.assert(body.headers["X-Script-Lang"], "==", "javascript", "Header set by the JS pre_script was echoed back");
    voiden.log("info", "JavaScript pre/post script scenario passed");
---
```

