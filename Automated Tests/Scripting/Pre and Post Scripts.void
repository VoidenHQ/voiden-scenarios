Shell has no `vd` alias and no `voiden.request.headers = ...` assignment form — only the `voiden.xxx` function calls, and `.push` to append without replacing.

```void
---
type: request
attrs:
  uid: "bc2f3a10-c418-4043-9c8f-ceac603f6355"
content:
  - type: method
    attrs:
      uid: "c02de30e-e1de-45ae-a4ec-64df8933d2bc"
      method: GET
      visible: true
    content: GET
  - type: url
    attrs:
      uid: "6461cd86-6e61-47f9-97f2-f104b0978109"
    content: "{{HTTPBIN_URL}}/headers"
---
```

```void
---
type: pre_script
attrs:
  uid: "12496339-4cf8-47a4-b5be-adf51dcbba1f"
  language: shell
  body: |
    voiden.request.headers.push "X-Script-Lang" "shell"
    voiden.variables.set "script_lang" "shell"
---
```

```void
---
type: post_script
attrs:
  uid: "4659f7dd-cd57-4828-992c-6b1af6f20b56"
  language: shell
  body: |
    HEADER_VALUE=$(voiden.response.body | jq -r '.headers["X-Script-Lang"]')
    voiden.assert "$(voiden.response.status)" "==" "200" "Status 200"
    voiden.assert "$HEADER_VALUE" "==" "shell" "Header set by the Shell pre_script was echoed back"
    voiden.log "info" "Shell pre/post script scenario passed"
---
```
