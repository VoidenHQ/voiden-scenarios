# Voiden local/session state — never commit
.voiden/env-private.yaml
.voiden/env-*-private.yaml
.voiden/.process.env.json

# voiden-runner local session/report output
.voiden-runner/
*.session.json

# OS
.DS_Store

# Node (only relevant if voiden-runner is installed locally instead of via CI action)
node_modules/

# Voiden
.voiden/*
!.voiden/env-public.yaml
!.voiden/env-*-public.yaml
.voiden-inherited.void
.voiden/**
# .voiden/history/ is per-editor undo history, always local-only — never
# tracked here, so no per-file allowlist entries are needed (or kept in sync
# with a renamed .void file's new history filename).
.voiden/history/Widget_Tools-334240c0-history.json
